{
  "name": "indian-rummy-game",
  "version": "2.0.0",
  "description": "Cross-platform real-time multiplayer 13-Card Indian Rummy game built with React.js, PixiJS WebGL 2D engine, Node.js, Socket.IO, and Capacitor Android.",
  "main": "server.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aravind00Kumar/Indian-rummy-game.git"
  },
  "keywords": [
    "rummy",
    "indian-rummy",
    "card-game",
    "multiplayer",
    "pixijs",
    "react",
    "webgl",
    "socket-io",
    "capacitor",
    "android-app"
  ],
  "author": "Aravind Kumar",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Aravind00Kumar/Indian-rummy-game/issues"
  },
  "homepage": "https://github.com/Aravind00Kumar/Indian-rummy-game#readme",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server.js",
    "build:apk": "node scripts/build-apk.js",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "npm run build && cap open android",
    "build:android": "node scripts/build-apk.js"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/cli": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/screen-orientation": "^6.0.4",
    "canvas-confetti": "^1.9.4",
    "pixi.js": "^7.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.2"
  }
}
